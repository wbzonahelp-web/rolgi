# Rolgi SStats Analytics Platform v6.0.0
# Environment Variables Configuration

# ======================
# SERVER CONFIGURATION
# ======================
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ======================
# DATABASE CONFIGURATION
# ======================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rolgi_v6
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Database Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000
DB_QUERY_TIMEOUT=30000

# ======================
# SSTATS API CONFIGURATION
# ======================
SSTATS_API_URL=https://api.sstats.net
SSTATS_API_KEY=your_sstats_api_key_here

# API Client Settings
API_RETRY_MAX=3
API_RETRY_DELAY=1000
API_RATE_LIMIT=300
API_TIMEOUT=30000

# ======================
# FEATURE FLAGS
# ======================
ENABLE_SWAGGER=true
ENABLE_CORS=true
ENABLE_RATE_LIMIT=true
ENABLE_SCHEDULED_JOBS=true
ENABLE_CACHE=true
ENABLE_METRICS=true
ENABLE_TRACING=true

# ======================
# SCHEDULED JOBS
# ======================
# Set individual jobs to false to disable
JOB_LOAD_LIVE_GAMES=true
JOB_UPDATE_LIVE_ODDS=true
JOB_LOAD_UPCOMING_GAMES=true
JOB_LOAD_FINISHED_GAMES=true
JOB_SYNC_TEAMS=true
JOB_SYNC_PLAYERS=true
JOB_UPDATE_STANDINGS=true
JOB_CLEANUP_OLD_LOGS=true
JOB_SYSTEM_HEALTH_CHECK=true

# ======================
# RATE LIMITING
# ======================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# ======================
# CACHE CONFIGURATION
# ======================
CACHE_TTL=300
CACHE_CHECK_PERIOD=60

# ======================
# MONITORING & TRACING
# ======================
METRICS_ENABLED=true
TRACING_ENABLED=true
HEALTH_CHECKS_ENABLED=true
TRACE_SAMPLE_RATE=0.1

# ======================
# REDIS (Optional)
# ======================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ======================
# SECURITY
# ======================
# JWT Configuration (for future auth implementation)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Admin API Key
ADMIN_API_KEY=your_admin_api_key_here

# ======================
# WEBSOCKET (Optional)
# ======================
WS_ENABLED=false
WS_PATH=/ws

# ======================
# FRONTEND
# ======================
FRONTEND_URL=http://localhost:3000

# ======================
# LOADER CONFIGURATION
# ======================
LOADER_BATCH_SIZE=100
LOADER_MAX_RETRIES=3
LOADER_ENABLE_VALIDATION=true
LOADER_ENABLE_PREFLIGHT=true
LOADER_SKIP_EXISTING=false

# ======================
# CIRCUIT BREAKER
# ======================
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60000

# ======================
# LOGGING
# ======================
LOG_PRETTY=true
LOG_FILE=false
LOG_FILE_PATH=./logs/app.log

# ======================
# DEVELOPMENT
# ======================
# Set to true to see detailed error stacks
DEBUG=false
DEV_MODE=false
