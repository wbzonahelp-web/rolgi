      "responseType": "AccountInfo"
    },
    {
      "category": "Games",
      "path": "/Games/list",
      "method": "GET",
      "description": "Get list of games with filtering",
      "parameters": [
        {"name": "leagueId", "type": "integer", "required": false},
        {"name": "season", "type": "integer", "required": false},
        {"name": "status", "type": "string", "required": false, "enum": ["scheduled", "live", "finished", "postponed", "cancelled"]},
        {"name": "dateFrom", "type": "string", "format": "date", "required": false},
        {"name": "dateTo", "type": "string", "format": "date", "required": false},
        {"name": "teamId", "type": "integer", "required": false},
        {"name": "page", "type": "integer", "required": false, "default": 1},
        {"name": "limit", "type": "integer", "required": false, "default": 100}
