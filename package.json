{
  "name": "sstats-analytics-platform",
  "version": "6.0.0",
  "description": "SStats Analytics Platform - Football match analytics with self-healing AI system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --selectProjects=unit",
    "test:integration": "jest --selectProjects=integration",
    "test:integration:watch": "jest --selectProjects=integration --watch",
    "test:e2e": "jest --selectProjects=e2e",
    "test:e2e:watch": "jest --selectProjects=e2e --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "preflight": "node src/core/preflight-checks.js",
    "db:init": "psql -U postgres -c 'CREATE DATABASE rolgi_v6;' && npm run db:schema:create",
    "db:schema:create": "psql -U postgres -d rolgi_v6 -f src/database/schema/postgres/001_init.sql",
    "db:schema:verify": "node src/database/schema-lock.js verify",
    "db:schema:update": "node src/database/schema-lock.js update",
    "db:schema:info": "node src/database/schema-lock.js info",
    "db:pool:test": "node src/database/db-pool.js test",
    "db:pool:health": "node src/database/db-pool.js health",
    "api:test": "node src/api/sstats-client.js test",
    "api:metrics": "node src/api/sstats-client.js metrics",
    "api:endpoints:validate": "node src/api/endpoint-lock.js validate",
    "api:endpoints:list": "node src/api/endpoint-lock.js list",
    "api:endpoints:stats": "node src/api/endpoint-lock.js stats",
    "loader:test": "node src/loader/data-loader.js test-games",
    "loader:stats": "node src/loader/data-loader.js stats",
    "upsert:list": "node src/database/upsert-keys.js list",
    "upsert:stats": "node src/database/upsert-keys.js stats",
    "deps:validate": "node src/database/table-dependencies.js",
    "monitoring:test": "node src/monitoring/monitoring.js test",
    "status-map:test": "node src/core/game-status-map.js",
    "validate:all": "npm run preflight && npm run db:schema:verify && npm run api:endpoints:validate && npm run deps:validate",
    "setup": "npm install && npm run db:init && npm run preflight",
    "docker:build": "docker build -t rolgi:6.0.0 .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "clean": "rm -rf node_modules package-lock.json",
    "reinstall": "npm run clean && npm install"
  },
  "keywords": [
    "football",
    "soccer",
    "analytics",
    "sstats",
    "flashscore",
    "api",
    "data-loader",
    "self-healing",
    "monitoring"
  ],
  "author": "wbzonahelp-web",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wbzonahelp-web/rolgi.git"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@apollo/server": "^5.3.0",
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^7.7.3",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^6.12.0",
    "@fastify/swagger": "^8.13.0",
    "@fastify/swagger-ui": "^2.1.0",
    "@slack/webhook": "^7.0.6",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "axios": "^1.13.4",
    "bcrypt": "^6.0.0",
    "dataloader": "^2.2.3",
    "dayjs": "^1.11.10",
    "dotenv": "^16.3.1",
    "fast-json-stringify": "^5.10.0",
    "fastify": "^4.25.2",
    "graphql": "^16.12.0",
    "graphql-tag": "^2.12.6",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "limiter": "^2.1.0",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.13",
    "pg": "^8.11.3",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "prom-client": "^15.1.3",
    "redis": "^5.10.0",
    "uuid": "^9.0.1",
    "ws": "^8.16.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "dredd": "^14.1.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  }
}