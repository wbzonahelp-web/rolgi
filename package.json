{
  "name": "sstats-analytics-platform",
  "version": "6.0.0",
  "description": "SStats Analytics Platform - Football match analytics with self-healing AI system",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "preflight": "node src/core/preflight-checks.js",
    "db:migrate": "node src/database/migrate.js",
    "db:schema:verify": "node src/database/schema-lock.js verify",
    "db:schema:update": "node src/database/schema-lock.js update",
    "loader:run": "node src/loader/cli.js run",
    "loader:status": "node src/loader/cli.js status",
    "validate:project": "node scripts/validate-project.js",
    "validate:dependencies": "node src/database/table-dependencies.js",
    "validate:response-types": "node src/api/response-types.js",
    "validate:playbook": "node src/monitoring/recovery-playbook.js",
    "validate:status-map": "node src/core/game-status-map.js"
  },
  "keywords": [
    "football",
    "soccer",
    "analytics",
    "sstats",
    "flashscore",
    "api",
    "data-loader",
    "self-healing",
    "monitoring"
  ],
  "author": "wbzonahelp-web",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wbzonahelp-web/rolgi.git"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "fastify": "^4.25.2",
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^6.12.0",
    "@fastify/swagger": "^8.13.0",
    "@fastify/swagger-ui": "^2.1.0",
    "pg": "^8.11.3",
    "dotenv": "^16.3.1",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "fast-json-stringify": "^5.10.0",
    "node-fetch": "^3.3.2",
    "ws": "^8.16.0",
    "uuid": "^9.0.1",
    "dayjs": "^1.11.10"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "@types/node": "^20.10.6",
    "dredd": "^14.1.0"
  }
}
